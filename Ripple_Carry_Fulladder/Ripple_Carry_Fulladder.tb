`timescale 1ns / 1ps

module rca_4bit_tb;
reg [3:0] a,b;
reg cin;
wire[3:0] sum;
wire c_out;

rca_4bit uut (.a(a), 
.b(b),
.cin(cin),
.sum(sum),
.c_out(c_out));

initial begin
$monitor("t=%0t a=%b (%d) b=%b (%d) cin=%b (%d) ->  c_out=%b sum=%b (%d)",$time ,a,a,b,b,cin,cin,c_out,sum,sum );

a=4'b0000; b=4'b0010; cin=0; #10;
a=4'b0100; b=4'b0001; cin=0; #10;
a=4'b0110; b=4'b0011; cin=0; #10;
a=4'b0111; b=4'b0101; cin=0; #10;
a=4'b1001; b=4'b0101; cin=0; #10;
a=4'b1011; b=4'b0001; cin=0; #10;
a=4'b1101; b=4'b0011; cin=1; #10;
a=4'b1110; b=4'b0100; cin=1; #10;
a=4'b1111; b=4'b1111; cin=1; #10;

$finish;
end

endmodule
