module decoder_2to4_tb;
reg [1:0] i;
reg en;
wire [3:0] y;

decoder_2to4 uut(.i(i),
.en(en),
.y(y));
initial begin
    en=0; i=2'b00;
    #10;
    en=1; i=2'b00;
    #10;
    
    i=2'b01;
    #10;
    
    i=2'b10;
    #10;
    i=2'b11;
    #10;
    en=0; i=2'b00;
    #10; 
    $finish;
    end
endmodule
