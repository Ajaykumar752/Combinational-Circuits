module claa_4_bit_tb;
 reg [3:0] a,b;
 reg cin;
 wire [3:0] sum;
 wire c_out;
claa_4_bit uut (.a(a),
 .b(b),
 .cin(cin), 
 .sum(sum), 
 .c_out(c_out));
initial begin
    $monitor("a=%b, b=%b, cin=%b, sum=%b, c_out=%b", a,b,cin,sum,c_out);
 
       a=4'b0000; b=4'b0001; cin=1'b0; #10;   // a=0 b=1
       a=4'b0011; b=4'b0101; cin=1'b0; #10;   // a=3 b=5
       a=4'b1110; b=4'b0011; cin=1'b1; #10;   // a=14 b=3
       a=4'b0111; b=4'b0111; cin=1'b0; #10;   // a=7 b=7
       a=4'b1000; b=4'b1001; cin=1'b1; #10;   // a=9 b=9
       a=4'b1100; b=4'b0011; cin=1'b0; #10;   // a=10 b=3
       a=4'b0000; b=4'b1110; cin=1'b0; #10;   // a=0 b=14
       a=4'b1111; b=4'b0101; cin=1'b0; #10;   // a=15 b=5
       a=4'b0111; b=4'b1011; cin=1'b1; #10;   // a=7 b= 11
       a=4'b1010; b=4'b0110; cin=1'b1; #10;   // a= 10 b= 6
    $finish;
  end
endmodule
